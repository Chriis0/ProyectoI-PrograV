@{
    ViewData["Title"] = "Inicio";
}

<!-- hero section -->
<div class="hero-section text-center py-5 mb-5">
    <div class="container">
        <i class="fas fa-building hero-icon mb-3"></i>
        <h1 class="display-4 fw-bold">Salón Comunal</h1>
        <p class="lead mb-4">Tu espacio ideal para eventos, celebraciones y reuniones comunales</p>
        @if (!User.Identity.IsAuthenticated)
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg me-3">
                <i class="fas fa-user-plus me-2"></i>Registrarse
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg">
                <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
            </a>
        }
        else
        {
            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="Producto" asp-action="Index" class="btn btn-primary btn-lg me-3">
                    <i class="fas fa-boxes me-2"></i>Ver Catálogo
                </a>
            }
            else
            {
                <a asp-controller="Reserva" asp-action="Index" class="btn btn-primary btn-lg me-3">
                    <i class="fas fa-calendar-check me-2"></i>Hacer una Reserva
                </a>
            }
        }
    </div>
</div>

<!-- Servicios -->
<div class="container mb-5">
    <h2 class="text-center mb-4">¿Qué ofrecemos?</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 text-center p-3">
                <div class="card-body">
                    <i class="fas fa-chair fa-3x mb-3" style="color: var(--dorado)"></i>
                    <h5 class="card-title">Mobiliario</h5>
                    <p class="card-text">Sillas, mesas y todo lo necesario para tu evento.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center p-3">
                <div class="card-body">
                    <i class="fas fa-utensils fa-3x mb-3" style="color: var(--dorado)"></i>
                    <h5 class="card-title">Alimentación</h5>
                    <p class="card-text">Comidas y bebidas disponibles para tus invitados.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center p-3">
                <div class="card-body">
                    <i class="fas fa-laptop fa-3x mb-3" style="color: var(--dorado)"></i>
                    <h5 class="card-title">Tecnología</h5>
                    <p class="card-text">Proyector, computadora, equipo de sonido y más.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Como funciona -->
<div class="container mb-5">
    <h2 class="text-center mb-4">¿Cómo funciona?</h2>
    <div class="row g-4 text-center">
        <div class="col-md-3">
            <div class="paso-circulo mx-auto mb-3">1</div>
            <h6 class="fw-bold">Regístrate</h6>
            <p class="text-muted small">Crea tu cuenta en segundos</p>
        </div>
        <div class="col-md-3">
            <div class="paso-circulo mx-auto mb-3">2</div>
            <h6 class="fw-bold">Elige los servicios</h6>
            <p class="text-muted small">Selecciona lo que necesitas del catálogo</p>
        </div>
        <div class="col-md-3">
            <div class="paso-circulo mx-auto mb-3">3</div>
            <h6 class="fw-bold">Reserva con 25%</h6>
            <p class="text-muted small">Asegura tu fecha con un adelanto</p>
        </div>
        <div class="col-md-3">
            <div class="paso-circulo mx-auto mb-3">4</div>
            <h6 class="fw-bold">Disfruta tu evento</h6>
            <p class="text-muted small">Cancela el total una semana antes</p>
        </div>
    </div>
</div>