@model IEnumerable<SalonComunalApp.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos y Servicios";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2>Catálogo de Productos y Servicios</h2>
            <p class="text-muted">Administración de productos disponibles en el salón comunal</p>
        </div>
        <div class="col text-end">
            <a asp-action="Create" class="btn btn-primary">
                + Agregar Producto
            </a>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Disponible</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.Nombre</td>
                    <td>@producto.Categoria</td>
                    <td>₡@producto.Precio.ToString("N2")</td>
                    <td>
                        @if (producto.Disponible)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@producto.Id" class="btn btn-sm btn-info">Ver</a>
                        <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>