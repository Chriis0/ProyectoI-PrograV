@model SalonComunalApp.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container mt-4">
    <h2>¿Eliminar este producto?</h2>
    <hr />

    <div class="alert alert-danger">
        Esta acción no se puede deshacer.
    </div>

    <div class="card" style="max-width: 500px;">
        <div class="card-body">
            <h4>@Model.Nombre</h4>
            <p>@Model.Descripcion</p>
            <p><strong>Categoría:</strong> @Model.Categoria</p>
            <p><strong>Precio:</strong> ₡@Model.Precio.ToString("N2")</p>
        </div>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>