@model List<Microsoft.AspNetCore.Identity.IdentityUser>

<h2>Usuarios y Roles</h2>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Email</td>
                <td>
                    <a asp-action="AsignarRol" asp-route-userId="@usuario.Id" class="btn btn-primary">
                        Cambiar Rol
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>