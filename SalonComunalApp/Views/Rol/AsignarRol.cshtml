@{
    ViewData["Title"] = "Cambiar Rol";
    var usuario = ViewBag.Usuario;
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
}

<h2 class="mb-4"><i class="fas fa-user-tag me-2 text-primary"></i>Cambiar Rol de Usuario</h2>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">Asignar Rol</div>
            <div class="card-body">
                <form asp-action="AsignarRol" method="post">
                    <input type="hidden" name="userId" value="@usuario.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Usuario</label>
                        <input class="form-control" value="@usuario.Email" disabled />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Nuevo Rol</label>
                        <select name="rol" class="form-select">
                            @foreach (var rol in roles)
                            {
                                <option value="@rol">@rol</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-save me-1"></i>Guardar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
