@model SalonComunalApp.Models.Reserva
@{
    ViewData["Title"] = "Cancelar Reserva";
    bool pierdeAdelanto = ViewBag.PierdeAdelanto ?? false;
}

<h2 class="mb-4"><i class="fas fa-times-circle me-2 text-danger"></i>Cancelar Reserva</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-@(pierdeAdelanto ? "danger" : "warning")">
            <div class="card-header bg-@(pierdeAdelanto ? "danger" : "warning") @(pierdeAdelanto ? "text-white" : "text-dark")">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @(pierdeAdelanto ? "⚠️ Cancelación tardía — Perderá el adelanto" : "Confirmar cancelación")
            </div>
            <div class="card-body">
                <p><strong>N.º Reserva:</strong> #@Model.Id</p>
                <p><strong>Fecha del evento:</strong> @Model.FechaEvento.ToString("dd/MM/yyyy")</p>
                <p><strong>Adelanto pagado:</strong> ₡@Model.MontoPagadoAdelanto.ToString("N2")</p>
                <p class="text-muted small">Fecha límite para cancelar sin perder adelanto: <strong>@ViewBag.FechaLimite</strong></p>

                @if (pierdeAdelanto)
                {
                    <div class="alert alert-danger mt-3">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        La fecha límite ya pasó. Si cancela ahora, <strong>no recibirá reembolso del adelanto de ₡@Model.MontoPagadoAdelanto.ToString("N2")</strong>.
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <form asp-action="CancelarConfirmado" asp-route-id="@Model.Id" method="post" class="flex-grow-1">
                        <button type="submit" class="btn btn-danger w-100"
                                onclick="return confirm('¿Está seguro de cancelar esta reserva?')">
                            <i class="fas fa-times me-2"></i>Sí, cancelar reserva
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>
