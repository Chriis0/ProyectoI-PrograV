@{
    ViewData["Title"] = "Nueva Reserva";
    var productos = ViewBag.Productos as List<SalonComunalApp.Models.Producto> ?? new();
}

<h2 class="mb-4"><i class="fas fa-calendar-plus me-2 text-success"></i>Nueva Reserva</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-7">
        <form asp-action="Create" method="post" id="reserva-form">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-calendar me-2"></i>Fecha del evento
                </div>
                <div class="card-body">
                    <input type="date" name="fechaEvento" class="form-control"
                           min="@DateTime.Now.AddDays(3).ToString("yyyy-MM-dd")" required />
                    <small class="text-muted">La fecha debe ser al menos 2 días en el futuro.</small>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-boxes me-2"></i>Seleccionar servicios
                </div>
                <div class="card-body p-0">
                    @if (!productos.Any())
                    {
                        <div class="p-3 text-muted">No hay productos disponibles.</div>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Seleccionar</th>
                                    <th>Servicio</th>
                                    <th>Precio</th>
                                    <th style="width:100px;">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in productos)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input producto-check"
                                                   name="productosIds" value="@p.Id" />
                                        </td>
                                        <td>
                                            <strong>@p.Nombre</strong>
                                            <div class="text-muted small">@p.Descripcion</div>
                                        </td>
                                        <td class="text-success fw-bold">₡@p.Precio.ToString("N2")</td>
                                        <td>
                                            <input type="number" name="cantidades" value="1" min="1"
                                                   class="form-control form-control-sm" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-lock me-2"></i>Pago del adelanto (25%) con Stripe
                </div>
                <div class="card-body">
                    <div id="card-element" class="form-control" style="padding:12px;height:auto;"></div>
                    <div id="card-errors" class="text-danger small mt-1"></div>
                    <input type="hidden" name="stripeToken" id="stripeToken" />
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg flex-grow-1" id="submit-btn">
                            <i class="fas fa-lock me-2"></i>Confirmar y pagar adelanto
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm border-warning">
            <div class="card-header bg-warning text-dark fw-bold">
                <i class="fas fa-info-circle me-2"></i>¿Cómo funciona?
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">✅ Pagas solo el <strong>25%</strong> ahora para asegurar tu fecha.</li>
                    <li class="mb-2">⏰ Tienes hasta <strong>7 días antes</strong> del evento para pagar el 75% restante.</li>
                    <li class="mb-2">❌ Si no pagas a tiempo, <strong>perderás el adelanto</strong> y el espacio quedará libre.</li>
                    <li>🔒 Si el espacio queda libre, otro cliente puede tomarlo pagando el <strong>total completo</strong> al menos 2 días antes.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        var stripe = Stripe('@ViewBag.StripePublicKey');
        var elements = stripe.elements();
        var cardElement = elements.create('card', { style: { base: { fontSize: '16px' } } });
        cardElement.mount('#card-element');

        cardElement.on('change', function(e) {
            document.getElementById('card-errors').textContent = e.error ? e.error.message : '';
        });

        document.getElementById('reserva-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            var btn = document.getElementById('submit-btn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';

            const { token, error } = await stripe.createToken(cardElement);
            if (error) {
                document.getElementById('card-errors').textContent = error.message;
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-lock me-2"></i>Confirmar y pagar adelanto';
            } else {
                document.getElementById('stripeToken').value = token.id;
                this.submit();
            }
        });
    </script>
}
